# Copy to .env and adjust. Read on the first start to write ~/.credits/config.ini; after that,
# config.ini is the source of truth (edit it directly).

# image tag: a release version (4.2.532-community.3) or latest
CREDITS_VERSION=latest
# host directory with the data, configuration and keys
CREDITS_HOME=~/.credits

# pruned (recent blocks only, starts from a snapshot) or full (every block: on rocksdb or lmdb it
# starts from a snapshot and fetches the older blocks in the background; on berkeleydb it syncs from
# block 0)
CREDITS_STORAGE=pruned
# block database: lmdb (default for pruned), rocksdb (default for full), berkeleydb (the official
# node's format; a full node only, syncs from block 0). Read on the first start only: an existing
# config.ini keeps its db_backend
#CREDITS_DB_BACKEND=
# first start with an empty data directory (pruned, or full on lmdb/rocksdb): github downloads the
# latest published snapshot (then the neighbours, then block 0), p2p asks only the neighbours, off
# syncs from block 0
CREDITS_SNAPSHOT=github
#CREDITS_SNAPSHOT_URL=https://github.com/CreditsCommunity/node/releases/download/pruned-snapshot/snapshot.json
# serve this node's snapshots to its neighbours (on, off); written to config.ini on the first start
CREDITS_SERVE_SNAPSHOT=on
# independent neighbours that must agree on a snapshot (default 2)
#CREDITS_SNAPSHOT_MIN_SOURCES=2

# p2p port, TCP and UDP; open it in the firewall
CREDITS_P2P_PORT=9510
# on: the Thrift API on 127.0.0.1:9090 of this host; the wallet in the container needs it
CREDITS_API=off
# on: the token cache of the API ([api] tokens_cache=true), so that the wallet lists every token held.
# Its first start reads all deployed contracts and their transactions (a while), then it reads token
# balances in the background after each token call
#CREDITS_TOKENS_CACHE=off
# the contract executor (needed to take part in consensus as a trusted node)
CREDITS_EXECUTOR=on

# full nodes, first start: off keeps only the snapshot's blocks instead of fetching the whole history
# from the neighbours in the background (on mainnet about 2 to 3 days, more on a slow disk or few
# cores, and about 250 to 300 GB with rocksdb, 400 GB or more with lmdb)
#CREDITS_BACKFILL=on

# container limits (docker-compose.yml). The defaults fit a pruned node on a shared server; a full
# node needs 4 cores and 8 GB: set CREDITS_CPUS=4 and CREDITS_MEMORY=8g
#CREDITS_CPUS=1.5
#CREDITS_MEMORY=4g

# set to 1 once to move the current data aside (~/.credits/old-<date>) and start over,
# e.g. after changing the block database; then remove it
#CREDITS_RESET=1

# convert an existing block database to the db_backend of config.ini instead of refusing to start
#CREDITS_CONVERT_DB=yes
